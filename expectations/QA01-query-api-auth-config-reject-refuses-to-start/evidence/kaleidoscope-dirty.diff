+/// an unset env tenant resolves to `None`, which the probe refuses.
+pub fn startup_probe_tenant(auth_enabled: bool, env_tenant: Option<TenantId>) -> Option<TenantId> {
+    if auth_enabled {
+        return Some(TenantId(STARTUP_PROBE_TENANT.to_string()));
+    }
+    env_tenant
+}
