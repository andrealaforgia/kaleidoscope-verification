# Per-expectation env overrides sourced by harness/run-expectation.sh.
# Used to lower the per-transport concurrency cap so a small client
# burst deterministically saturates aperture and exercises the
# refusal path. Kept tight so the test does not depend on host CPU
# scheduling.
APERTURE__TRANSPORT__GRPC__MAX_CONCURRENT_REQUESTS=1
APERTURE__TRANSPORT__HTTP__MAX_CONCURRENT_REQUESTS=1
