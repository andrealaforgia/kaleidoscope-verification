# Per-expectation env-var overrides for aperture (sourced by
# harness/run-expectation.sh, then passed through to the aperture
# container per docker-compose.yml's environment: block).
#
# Used since 2026-05-07 (issue 002 fixed at kaleidoscope c8d8a55):
# the figment loader now merges Env::prefixed("APERTURE__") on top
# of Toml::file, so a single env-var setting can lower the per-
# transport concurrency cap without shipping a per-expectation
# aperture.toml.
APERTURE__TRANSPORT__GRPC__MAX_CONCURRENT_REQUESTS=1
APERTURE__TRANSPORT__HTTP__MAX_CONCURRENT_REQUESTS=1
