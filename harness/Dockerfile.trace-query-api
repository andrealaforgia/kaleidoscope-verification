# syntax=docker/dockerfile:1.7
#
# Kaleidoscope trace-query-api runtime image — CATALOGUE-AUTHORED.
#
# Honesty note: as with log-query-api, the kaleidoscope project ships
# no Dockerfile for trace-query-api at HEAD. This image is authored by
# the expectations catalogue purely to stand the binary up as a
# black-box service so its HTTP contract can be observed. It is
# modelled verbatim on the project's Dockerfile.query-api (same
# rust:1.88-slim-bookworm builder, same debian:bookworm-slim runtime,
# same --locked release build). The binary, the workspace, and
# Cargo.lock are all the project's own, taken from the
# `git archive HEAD` snapshot. The only catalogue-introduced artefact
# is this file.
#
# `trace-query-api` is the Ray read side: an axum HTTP service over
# the durable Ray trace store. It opens the store at `pillar_root/ray`
# (the same path the gateway writes through), resolves the tenant from
# KALEIDOSCOPE_TRACE_QUERY_TENANT (fail-closed if unset), runs the
# Earned-Trust probe, then binds the listener (default 0.0.0.0:9092).
# Routes: GET /api/v1/traces?service=&start=&end= and
# GET /api/v1/traces/by_id?trace_id=<32-hex> (ADR-0053).

# -----------------------------------------------------------------
# Stage 1 — Build
# -----------------------------------------------------------------
FROM rust:1.88-slim-bookworm AS builder

WORKDIR /workspace

COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY crates ./crates
COPY xtask ./xtask

RUN cargo build --release -p trace-query-api --locked

# -----------------------------------------------------------------
# Stage 2 — Runtime
# -----------------------------------------------------------------
FROM debian:bookworm-slim AS runtime

COPY --from=builder /workspace/target/release/trace-query-api \
    /usr/local/bin/trace-query-api

# The Ray pillar lives under this volume at /data/ray. Mount the same
# volume the gateway writes to so the read service sees what was
# ingested. The binary defaults pillar_root to /data and the listener
# to 0.0.0.0:9092.
ENV KALEIDOSCOPE_PILLAR_ROOT=/data
ENV KALEIDOSCOPE_TRACE_QUERY_ADDR=0.0.0.0:9092
WORKDIR /data
VOLUME ["/data"]

# Ray trace query HTTP API.
EXPOSE 9092

ENTRYPOINT ["/usr/local/bin/trace-query-api"]
